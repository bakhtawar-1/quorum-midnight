# Quorum — environment configuration
#
# Copy to `.env` and load it with Node's built-in flag:
#   node --env-file=.env --import tsx server/index.ts
# `.env` is gitignored. Nothing here is read unless you pass it in the environment.
#
# In development every value below has a safe built-in default and may be omitted.
# When NODE_ENV=production, the ones marked (required in prod) MUST be set or the
# server refuses to start (see server/config.ts).

# ── runtime mode ────────────────────────────────────────────────────────────────
# Set to "production" to enforce the checks below.
NODE_ENV=development

# ── Quorum API (server/index.ts) ───────────────────────────────────────────────
QUORUM_API_PORT=8787

# Corroborating reporters needed to unlock a bucket. Baked into the contract at
# deploy; changing it forces a redeploy.
QUORUM_THRESHOLD=2

# Issuer credential secret. Drives `issuerCommitment` (deploy arg 2). Whoever
# knows this can register identity credentials.  (required in prod)
QUORUM_ISSUER_SECRET=change-me-to-a-long-random-string

# Password encrypting the LevelDB private-state store.  (required in prod)
QUORUM_PRIVATE_STATE_PASSWORD=change-me-too

# Seeded identity-credential pool the demo issuer registers on first boot.
# In production you would issue credentials per real person instead of seeding.
QUORUM_IDENTITY_POOL=citizen-1,citizen-2,citizen-3

# Bearer token gating POST /api/enroll, /api/report, /api/reveal. Unset in dev
# leaves those endpoints open.  (required in prod)
# QUORUM_API_TOKEN=

# Comma-separated browser origins allowed to call the API. "*" is rejected when
# NODE_ENV=production.  (required in prod)
QUORUM_CORS_ORIGIN=*

# Per-IP fixed-window rate limit applied to the mutating endpoints.
QUORUM_RATELIMIT_WINDOW_MS=60000
QUORUM_RATELIMIT_MAX=20

# ── Email-allowlist credential issuance ───────────────────────────────────────
# Emails the issuer has verified as distinct people. Merged into
# server/.allowlist.json (gitignored) on boot; the issuer can then edit that file.
QUORUM_ALLOWLIST=alice@example.org,bob@example.org
# Or point at a file the issuer maintains elsewhere:
# QUORUM_ALLOWLIST_FILE=/etc/quorum/allowlist.json

# Where claim links point (the UI origin). Link form: <base>/?claim=<token>
QUORUM_UI_BASE_URL=http://localhost:5173
# Claim-link lifetime.
QUORUM_MAGIC_TTL_MS=1800000

# From address on the claim email.  (required in prod)
QUORUM_EMAIL_FROM=Quorum <no-reply@quorum.local>
# SMTP connection URL for real sending, e.g. smtps://user:pass@smtp.provider.com:465
# Unset in dev → the claim link is printed to the API console instead.
# Needs `npm i nodemailer`.  (required in prod)
# QUORUM_SMTP_URL=

# ── Distributed escrow (server/escrow-node.ts) ────────────────────────────────
QUORUM_ESCROW_COUNT=3
QUORUM_ESCROW_THRESHOLD=2
QUORUM_ESCROW_BASE_PORT=8801
# Set to 0 to not spawn escrow nodes from the API process.
QUORUM_SPAWN_ESCROW=1

# ── Midnight network / wallet (src/network.ts) — see docs/MIDNIGHT.md ──────────
# MIDNIGHT_INDEXER_URL=
# MIDNIGHT_INDEXER_WS_URL=
# MIDNIGHT_NODE_URL=
# MIDNIGHT_PROOF_SERVER_URL=
# MIDNIGHT_FAUCET_URL=
# MIDNIGHT_FAUCET_TIMEOUT_MS=600000
# One of seed / mnemonic (never both). Do not commit a funded wallet's values.
# MIDNIGHT_WALLET_SEED=
# MIDNIGHT_WALLET_MNEMONIC=

# ── UI (ui/, Vite — must be prefixed VITE_) ───────────────────────────────────
# VITE_QUORUM_API=http://localhost:8787
